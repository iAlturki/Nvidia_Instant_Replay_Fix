#include <windows.h>

/* Application icon */
1 ICON "app.ico"

/* Embed the application manifest (asInvoker, DPI-aware, Win10/11). 24 = RT_MANIFEST,
 * 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID - numeric form is portable across windres + rc.exe. */
1 24 "app.manifest"

/* Version info - gives the exe real metadata so generic AV heuristics treat it
 * as a normal application instead of an anonymous binary. */
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x40004L
FILETYPE        0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "iALTURKi"
      VALUE "FileDescription",  "Nvidia Instant Replay Fix - keeps NVIDIA ShadowPlay recording"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "Nvidia_Instant_Replay_Fix"
      VALUE "LegalCopyright",   "Copyright (C) 2026 iALTURKi. MIT License."
      VALUE "OriginalFilename", "Nvidia_Instant_Replay_Fix.exe"
      VALUE "ProductName",      "Nvidia_Instant_Replay_Fix"
      VALUE "ProductVersion",   "1.0.0.0"
      VALUE "Comments",         "https://github.com/iALTURKi/Nvidia_Instant_Replay_Fix"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
